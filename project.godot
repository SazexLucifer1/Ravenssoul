[internationalization]

locale/translations=PackedStringArray("res://assets/localization/en.po", "res://assets/localization/de.po")
locale/fallback="en"
pseudolocalization/expansion_ratio=0.3
pseudolocalization/prefix="["
pseudolocalization/suffix="]"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="units"
2d_physics/layer_3="interactables"
2d_physics/layer_4="pointer_pick"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
